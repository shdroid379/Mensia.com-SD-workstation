# Vin pipeline environment. Copy to .env and fill in real values.
# Never commit real keys. Vin reads this file next to vin.py.

# --- stage 1: planner (Llama 3.3 70B via Groq) ---
GROQ_KEY=

# --- stage 2/3: retrieval ---
TAVILY_KEY=
YOU_API_KEY=
EXA_API_KEY=

# --- stage 3: reranker (Cloudflare Workers AI) ---
# The auth token alone is not enough: the Workers AI URL is account-scoped.
# Find the account id in the Cloudflare dashboard sidebar, or in the URL when
# logged in. Without it Vin keeps unranked chunks and logs a warning.
# VERIFIED working 2026-10-04 with @cf/baai/bge-reranker-base.
CLOUDFLARE_ACCOUNT_ID=
# The token may be named CLOUDFLARE_AUTH_TOKEN, CLOUDFLARE_TOKEN or Cloudfare_token.
CLOUDFLARE_AUTH_TOKEN=

# --- stage 4: evidence ledger (Qwen3-235B via nScale OpenAI-compatible endpoint) ---
# Used by the extraction/claim-detection channel. No fallback model: if the
# ledger model call fails, the pipeline degrades to verbatim chunk spans.
NSCALE_API_KEY=

# --- gemini developer api (used by ai_answer.py, the standalone Gemini tool) ---
# Not part of the Vin pipeline stages; served by the Gemini Developer API.
GEMINI_API_KEY=

# --- stage 5: dossier (Kimi K2.5 via nScale), fallback MiMo V2.5 via GMI Cloud ---
NSCALE_API_KEY=
GMICLOUD_API_KEY=

# --- stage 6: red team (opposition bench, MiMo V2.5 via GMI Cloud) ---
# GMICLOUD_API_KEY is listed above with the dossier fallback.

# --- stage 7: patch (Solar Pro 4 via Upstage) ---
UPSTAGE_API_KEY=

# --- stage 8: audit (DeepSeek V4 Flash via Routeway, fallback via Final Router) ---
# Routeway's free tier (deepseek-v4-flash:free) is the primary because it answers long
# audit prompts on the free tier of credits. The paid deepseek-v4-flash on Routeway
# returns 402 without credits, so leave the model id on the :free variant.
ROUTEWAY_API_KEY=
FINALROUTER_API_KEY=

# --- stage 9: polish (minimax-m2.7 via LLM7) ---
LLM7_API_KEY=

# --- optional tuning (defaults shown) ---
# RERANK_MIN_SCORE=0.30
# RERANK_BATCH=32
# Dossier length. The prompt targets a floor of 16,000 output tokens and asks
# Kimi to stop on a complete sentence, so DOSSIER_MAX_TOKENS must stay above
# the prompt's own ceiling or the stream gets cut off mid-sentence. The total
# and idle timeouts are sized for a full-length streamed write.
# DOSSIER_MAX_TOKENS=20000
# DOSSIER_TOTAL_TIMEOUT=900
# DOSSIER_IDLE_TIMEOUT=180
# Warns when reasoning overruns the 6,000-char target; the hard ceiling in
# instruc_prompt.DOSSIER_SYSTEM is 8,000 characters.
# REASONING_WARN_CHARS=6000
# POLISH_MIN_RATIO=0.98
# COUNTER_EVIDENCE_TOKEN_BUDGET=4000
# VIN_RESEARCH_PROVIDER_A=tavily
# VIN_RESEARCH_PROVIDER_B=you
# VIN_PLAN_MODEL=llama-3.3-70b-versatile
# VIN_PLAN_FALLBACK_MODEL=qwen/qwen3.8-27b
# VIN_LEDGER_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
# VIN_DOSSIER_MODEL=moonshotai/Kimi-K2.5
# VIN_REDTEAM_MODEL=XiaomiMiMo/MiMo-V2.5
# VIN_PATCH_MODEL=solar-pro4
# VIN_AUDIT_MODEL=deepseek-v4-flash:free
# DURALUMIN additions
COHERE_API_KEY=
VIN_PROFILER_MODEL=openai/gpt-oss-20b
VIN_INSPECTOR_MODEL=command-a-03-2025

# --- cinema_report.py (optional) ---
# When absent, cinema_report.py uses the authenticated local Ollama relay.
OLLAMA_API_KEY=
# Optional cinematic-report media path. A clip is generated only when Beam writes
# media_plan.json with video.needed=true; FAL is tried first, then KIE once.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
FAL_API_KEY=
KIE_API_KEY=
# ComfyUI and Blender MCPs are local, open-source tools: they need no API key.
# Install their local runtimes before enabling the matching mcp_servers.json entries.

# --- mensia backend: limits, access codes, Vin jobs (main.py / quotas.py / vin_jobs.py) ---
# Firestore is reached with firebase_service_account.json (or FIREBASE_SERVICE_ACCOUNT_JSON
# on Render); there is no database URL to configure here.
#
# Guards POST /admin/access/codes and /admin/access/list — the endpoints your local
# access_codes.html calls. Generate a long random string, put it on Render as an
# environment variable, and never put it in the frontend.
MENSIA_ADMIN_SECRET=
#
# Mixed into the SHA-256 of every access code before it is stored. Codes are kept as
# hashes only, so changing this invalidates every code you have already issued.
# Leave it alone once real codes are in circulation.
MENSIA_CODE_PEPPER=mensia-access-v1
#
# How many Vin runs one process executes at a time. Render's free instance has 512 MB
# and a Vin run holds a whole web-corpus in memory, so keep this at 1 there.
VIN_MAX_CONCURRENT=1
# A run interrupted by a redeploy restarts from scratch this many times before it
# fails and refunds the query.
VIN_MAX_ATTEMPTS=2

